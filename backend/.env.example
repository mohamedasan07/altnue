# Copy to .env and edit values
# ---------------------------------------------------------------------------
# DEVELOPMENT mode (no CORS_ORIGINS needed):
# ---------------------------------------------------------------------------
NODE_ENV=development
ADMIN_EMAIL=admin@unsorted.com
ADMIN_PASSWORD=admin123
SESSION_SECRET=mysecretkey123
PORT=3001

# ---------------------------------------------------------------------------
# PRODUCTION mode — uncomment and set to only the deployed frontend domain(s).
# Comma-separated list, no trailing slashes, origin only (no paths).
# Requests with no Origin header (curl/Postman/server-to-server) are always
# allowed; ONLY these domains are allowed CORS access:
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3001
# CORS_ORIGINS=https://unsorted-swart.vercel.app
# CORS_ORIGINS=https://unsorted-swart.vercel.app,https://admin.unsorted.com

