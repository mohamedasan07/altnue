# Normalize line endings to LF in the repository.
# Files are checked out with native (CRLF on Windows) line endings on disk.
* text=auto

# Text files explicitly stored as LF in the repo
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf

# Binary files — never touch
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary